{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Nitro's Cloudflare preset merges this file into the deploy config it
  // writes at build time, then adds `pages_build_output_dir` (or `main` +
  // `assets` for the Workers preset) and `nodejs_compat` itself. Declare
  // bindings and plain vars here; keep every secret out (see README →
  // Deploying).
  "name": "africa-energy-atlas",
  "compatibility_date": "2025-07-13",

  // The contribution queue, editorial audit trail and Better Auth's identity
  // tables. `database_id` comes from `wrangler d1 create` — see the README.
  // On Pages this binding is also settable in the dashboard under
  // Settings → Bindings, which is what the deployed project actually reads.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "africa-energy-atlas",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  "observability": {
    "enabled": true
  }
}
